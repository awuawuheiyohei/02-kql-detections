// =============================================================================
// KQL 检测规则 02：特权账户异常操作
// =============================================================================
// 规则名称    : Privileged Account - Anomalous Role Assignment
// 规则 ID      : KQL-002
// 战术        : TA0005 Privilege Escalation
// 检测逻辑    : 特权账户被授予新角色，且该角色在 30 天内未使用过
// 数据源      : AuditLogs (RoleManagement / RoleEligibility)
// 误报场景    : 新员工入职、工单系统自动授权、轮岗
// 调优建议    : 建立"角色使用基线"，只对偏离基线的授权告警
// -----------------------------------------------------------------------------

let LookbackDays = 30d;
let SuspiciousRoles = dynamic(["Global Administrator", "Company Administrator",
    "Security Administrator", "Exchange Administrator", "Privileged Role Administrator"]);

// 1) 找出"冷门"角色（30 天内从未被使用过的）
let ColdRoles = Materialize(
    AuditLogs
    | where TimeGenerated > ago(LookbackDays)
    | where OperationNameValue =~ "Add member to role"
    | extend RoleName = tostring(TargetResources[0].displayName)
    | summarize LastUsed = max(TimeGenerated) by RoleName
    | where LastUsed < ago(LookbackDays)                    // 30 天未使用
    | project RoleName
);

// 2) 检测：特权账号被授予冷门角色
AuditLogs
| where TimeGenerated > ago(24h)
| where OperationNameValue =~ "Add member to role"
| where ResultType == 0                                      // 成功
| extend
    RoleName = tostring(TargetResources[0].displayName),
    TargetUser = tostring(TargetResources[0].Properties[0].Value),
    Initiator = tostring(Caller),
    InitiatorIp = tostring(IpAddress),
    UserAgent = tostring(UserAgent)
| where RoleName in~ (SuspiciousRoles)                      // 高危角色
| join kind=leftouter (
    ColdRoles | project RoleName, ColdRoleFlag = 1
) on RoleName
| extend
    AlertSeverity = case(
        ColdRoleFlag == 1 and IsUserSecurityAdmin, "Critical",     // 冷门高危角色
        ColdRoleFlag == 1, "High",
        "Medium"
    ),
    // 是否在正常工作时间内（UTC+8 → UTC）
    IsWorkingHours = hourofday(TimeGenerated) >= 1 and hourofday(TimeGenerated) <= 9
| project
    Timestamp = TimeGenerated,
    Initiator,
    InitiatorIp,
    TargetUser,
    RoleName,
    AlertSeverity,
    ColdRoleFlag,
    IsWorkingHours,
    UserAgent
| order by Timestamp desc
```

---

// =============================================================================
// KQL 检测规则 03：批量设备认证失败（对应真实事故场景）
// =============================================================================
// 规则名称    : Mass Device Authentication Failure
// 规则 ID      : KQL-003
// 战术        : TA0006 Credential Access
// 检测逻辑    : 短时间内大量设备出现 Intune / AAD 认证失败（证书过期、CRL 不可达等）
// 数据源      : SigninLogs + AuditLogs
// 误报场景    : 大规模发版、Token 刷新峰值
// 调优建议    : 与设备管理窗口对比；排除已知发版窗口
// -----------------------------------------------------------------------------

let TimeWindow = 30m;
let FailureThreshold = 20;                                    // 30 分钟内 20+ 次失败
let FailureErrorCodes = dynamic([
    50079,   // MFA required
    50105,   // User not assigned license
    7000215, // Invalid client secret
    700027,  // Client assertion expired
    700016,  // Application not found (证书链问题常见)
    7000222, // Expired token
    50053,   // Account locked out
    53003,   // Blocked by Conditional Access
    0        // Generic auth failure
]);

SigninLogs
| where TimeGenerated > ago(TimeWindow)
| where ResultType != 0                                      // 失败
| extend
    ResourceApp = tostring(AppDisplayName),
    IsIntuneRelated = ResourceApp in~ ("Microsoft Intune", "Company Portal", "Microsoft Endpoint Manager"),
    IsDevice = tobool(IsDeviceAuthenticated),
    ErrorCode = tostring(ResultType)
| where ErrorCode in (FailureErrorCodes) or ResultType == 0
| summarize
    FailureCount = count(),
    UniqueDevices = dcount(DeviceId),
    UniqueUsers = dcount(UserPrincipalName),
    ErrorBreakdown = make_set(ErrorCode, 10),
    AffectedApps = make_set(ResourceApp, 10),
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated)
    by ResultType
| where FailureCount >= FailureThreshold
| extend
    AlertSeverity = case(
        UniqueDevices >= 50 and IsIntuneRelated, "Critical",    // 大规模设备 + Intune
        UniqueDevices >= 20, "High",
        "Medium"
    ),
    LikelyCause = case(
        // 常见根因判断（基于错误码组合）
        array_has_any(ErrorBreakdown, dynamic(["700016"])), "Certificate Chain / App Registration Issue",
        array_has_any(ErrorBreakdown, dynamic(["7000222"])), "Expired Token / Certificate",
        array_has_any(ErrorBreakdown, dynamic(["50079"])),   "MFA Policy Issue",
        array_has_any(ErrorBreakdown, dynamic(["53003"])),   "Conditional Access Block",
        "Unknown - Investigate"
    ),
    RecommendedAction = case(
        LikelyCause == "Certificate Chain / App Registration Issue",
        "Check CRL distribution point reachability and certificate chain validity",
        LikelyCause == "Expired Token / Certificate",
        "Verify device certificate renewal status and SCEP endpoints",
        "Escalate to platform team for investigation"
    )
| project
    Timestamp = EndTime,
    AlertSeverity,
    LikelyCause,
    RecommendedAction,
    FailureCount,
    UniqueDevices,
    UniqueUsers,
    ErrorCode = ResultType,
    ErrorBreakdown = tostring(ErrorBreakdown),
    AffectedApps = tostring(AffectedApps),
    TimeSpanMinutes = datetime_diff('minute', StartTime, EndTime)
| order by Timestamp desc
```

