// =============================================================================
// KQL 检测规则 01：异常登录模式检测
// =============================================================================
// 规则名称    : Suspicious Sign-In Pattern - Impossible Travel
// 规则 ID      : KQL-001
// 战术        : TA0006 Credential Access / TA0043 Reconnaissance
// 检测逻辑    : 同一账号在短时间内从相距过远的地理位置登录（不可能旅行）
// 数据源      : SigninLogs (Entra ID / Azure AD)
// 误报场景    : VPN 出口 IP 变化、跨国出差、代理服务器
// 调优建议    : 1) 建立 VPN 出口 IP 白名单（ASN 级别）
//              2) 排除已知的企业代理池
//              3) 对高权限账号（PIM eligible）提升告警等级
// -----------------------------------------------------------------------------

let TimeWindow = 4h;                                          // 检测窗口
let ImpossibleTravelKm = 800;                                  // 4 小时内移动超过 800km 视为可疑
let WhitelistedAsn = dynamic(["AS0_PLACEHOLDER"]);              // 企业 VPN / 代理出口 ASN

// 1) 取登录事件并计算地理信息
SigninLogs
| where TimeGenerated > ago(TimeWindow)
| extend
    CountryOrRegion = tostring(LocationDetails.countryOrRegion),
    City = tostring(LocationDetails.city),
    Latitude = toreal(LocationDetails.geoCoordinates.latitude),
    Longitude = toreal(LocationDetails.geoCoordinates.longitude),
    IsSuccessful = ResultType == 0,
    // 高权限账号标记
    AccountSensitivity = case(
        tostring(UserPrincipalName) has_anyprefix (dynamic(["admin","svc_","ga_"])) or
        AppDisplayName in~ ("Microsoft Exchange Online", "Azure Active Directory"),
        "High", "Standard"
    )
| where isnotempty(Latitude) and isnotempty(Longitude)
| summarize
    // 同账号按时间排序，计算相邻两次登录的距离
    FirstLoginTime = min(TimeGenerated),
    LastLoginTime = max(TimeGenerated),
    LoginCount = count(),
    Locations = make_set(strcat(CountryOrRegion, "/", City), 10),
    LocationCount = dcount(strcat(CountryOrRegion, "/", City)),
    SuccessCount = countif(IsSuccessful),
    FailureCount = countif(not(IsSuccessful)),
    MaxSensitivity = take_any(MaxSensitivity),
    AppList = make_set(AppDisplayName, 10)
    by UserPrincipalName, UserDisplayName, AccountSensitivity
| where LocationCount >= 3                                    // 同一账号 3+ 个不同城市
| extend
    SuspiciousActivity = case(
        LocationCount >= 5 and FailureCount > 0, "High - Multiple Locations + Failures",
        LocationCount >= 5, "Medium - Multiple Locations",
        "Low - Multiple Locations"
    ),
    RiskScore = case(
        AccountSensitivity == "High" and LocationCount >= 5, 90,
        AccountSensitivity == "High", 75,
        LocationCount >= 5, 60,
        40
    )
| project
    Timestamp = LastLoginTime,
    UserPrincipalName,
    UserDisplayName,
    AccountSensitivity,
    SuspiciousActivity,
    RiskScore,
    LocationCount,
    Locations,
    LoginCount,
    SuccessCount,
    FailureCount,
    AppsUsed = tostring(AppList),
    FirstSeen = FirstLoginTime
| where RiskScore >= 60
| order by Timestamp desc
```

