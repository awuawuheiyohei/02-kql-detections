// =============================================================================
// KQL 检测规则 04：数据外泄风险 - 异常批量下载
// =============================================================================
// 规则名称    : Data Exfiltration Risk - Mass Download
// 规则 ID      : KQL-004
// 战术        : TA0010 Exfiltration
// 检测逻辑    : 单一账号短时间下载大量敏感文件
// 数据源      : CloudAppEvents / OfficeActivity
// 误报场景    : 数据迁移、合规导出、备份任务
// 调优建议    : 对已知的数据工程账号做白名单
// -----------------------------------------------------------------------------

OfficeActivity
| where Operation == "FileSyncDownloaded" or Operation == "FileSyncDownloadedMultiple"
| where TimeGenerated > ago(2h)
| extend
    FileSizeMB = todouble(FileSize) / 1024 / 1024,
    SensitivityLabel = tostring(SensitivityLabel),
    UserSensitivity = case(
        tostring(UserId) has_anyprefix (dynamic(["admin", "svc_"])), "High", "Standard"
    ),
    IsSensitive = SensitivityLabel in~ ("Confidential", "Highly Confidential")
| summarize
    DownloadCount = count(),
    TotalSizeMB = sum(FileSizeMB),
    UniqueFiles = dcount(Name),
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated),
    FileTypes = make_set(FileType, 10),
    Labels = make_set(SensitivityLabel, 5)
    by UserId, UserDisplayName, UserSensitivity, IsSensitive
| where
    DownloadCount >= 50 or
    (TotalSizeMB >= 2048) or                                   // 单账号 2GB
    (IsSensitive and DownloadCount >= 10)
| extend
    AlertSeverity = case(
        UserSensitivity == "High" and IsSensitive and TotalSizeMB >= 2048, "Critical",
        IsSensitive and TotalSizeMB >= 1024, "High",
        "Medium"
    )
| project
    Timestamp = EndTime,
    UserId,
    UserDisplayName,
    AlertSeverity,
    DownloadCount,
    UniqueFiles,
    TotalSizeMB = round(TotalSizeMB, 2),
    FileTypes = tostring(FileTypes),
    SensitivityLabels = tostring(Labels),
    DurationMinutes = datetime_diff('minute', StartTime, EndTime)
| order by Timestamp desc
```

---

// =============================================================================
// KQL 检测规则 05：影子 IT - 未授权云服务访问
// =============================================================================
// 规则名称    : Shadow IT - Unauthorized Cloud Service Access
// 规则 ID      : KQL-005
// 战术        : TA0002 Initial Access
// 检测逻辑    : 用户访问未在企业 App 许可清单中的云服务
// 数据源      : CloudAppEvents
// 误报场景    : 个人账号处理工作（需政策沟通）、新服务未纳管
// 调优建议    : 建立并维护企业 SaaS 许可清单；新服务需 IT 审批
// -----------------------------------------------------------------------------

let ApprovedApps = dynamic([
    "Microsoft 365", "Microsoft Teams", "Microsoft SharePoint",
    "Microsoft Exchange Online", "Microsoft Azure", "Microsoft Entra ID"
]);

CloudAppEvents
| where TimeGenerated > ago(24h)
| extend
    ServiceName = split(Application, " - ")[0],           // 提取服务名
    AppId = tostring(AppId)
| where ServiceName !in (ApprovedApps)
| summarize
    AccessCount = count(),
    FirstAccess = min(TimeGenerated),
    LastAccess = max(TimeGenerated),
    Actions = make_set(ActionType, 10),
    UserAgent = make_set(UserAgent, 5)
    by UserId, UserDisplayName, ServiceName, AppId
| extend
    AlertSeverity = case(
        AccessCount >= 100, "High",
        AccessCount >= 20, "Medium",
        "Low"
    ),
    RecommendedAction = case(
        ServiceName has_any ("dropbox", "box", "wetransfer", "mega", "icloud"),
        "Block access - unapproved file sharing service",
        "Review with IT - is this an approved business tool?"
    )
| project
    Timestamp = LastAccess,
    UserId,
    UserDisplayName,
    ServiceName,
    AppId,
    AlertSeverity,
    AccessCount,
    Actions = tostring(Actions),
    RecommendedAction
| order by AlertSeverity desc, Timestamp desc
```

---

// =============================================================================
// KQL 检测规则 06：MFA 疲劳攻击检测
// =============================================================================
// 规则名称    : MFA Fatigue / Phishing-resistant Attack
// 规则 ID      : KQL-006
// 战术        : TA0006 Credential Access
// 检测逻辑    : 同一账号短时间内大量 MFA 失败后伴随一次成功（用户在"被轰炸"后妥协）
// 数据源      : SigninLogs
// 误报场景    : 密码管理器重复提交、设备时钟漂移导致的重复推送
// 调优建议    : 关联设备 ID；排除可信设备（已注册 MFA 的设备）
// -----------------------------------------------------------------------------

let Window = 1h;
let MfaFailureBurst = 5;                                      // 1 小时内 5+ 次 MFA 失败
let SuccessAfterFailures = 2;                                 // 至少 2 次失败后成功

SigninLogs
| where TimeGenerated > ago(Window)
| extend
    IsMfaEvent = ResultType in (50079, 50072, 50066, 53003),  // MFA 相关的失败码
    IsSuccess = ResultType == 0,
    DeviceId = tostring(DeviceId),
    Location = strcat(tostring(LocationDetails.countryOrRegion), "/", tostring(LocationDetails.city))
| where IsMfaEvent or IsSuccess
| summarize
    MfaFailures = countif(IsMfaEvent),
    SuccessCount = countif(IsSuccess),
    Locations = make_set(Location, 10),
    Devices = make_set(DeviceId, 10),
    IpAddresses = make_set(IpAddress, 10),
    FirstEvent = min(TimeGenerated),
    LastEvent = max(TimeGenerated)
    by UserPrincipalName, UserDisplayName
| where MfaFailures >= MfaFailureBurst and SuccessCount >= 1
| extend
    AlertSeverity = case(
        MfaFailures >= 15, "Critical",
        MfaFailures >= 10, "High",
        "Medium"
    ),
    IsMfaFatiguePattern = MfaFailures >= MfaFailureBurst and SuccessCount >= SuccessAfterFailures,
    RecommendedAction = "Force password reset + revoke sessions + verify user identity out-of-band"
| project
    Timestamp = LastEvent,
    UserPrincipalName,
    UserDisplayName,
    AlertSeverity,
    MfaFailures,
    SuccessCount,
    Locations = tostring(Locations),
    Devices = tostring(Devices),
    SourceIPs = tostring(IpAddresses),
    RecommendedAction
| order by AlertSeverity desc, Timestamp desc
```
